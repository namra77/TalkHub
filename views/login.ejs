<% if (typeof message !=='undefined' ) { %>
  <h4 style="color:red;">
    <%= message %>
  </h4>
  <% } %>
    <section class="section d-flex  justify-content-center align-items-center">
      <div class="box floating">

      </div>

      <div class="form-container fade-in">
        <form class="form align-items-center" action="" method="POST">
          <h1>Welcome Back</h1>
          <h2>Login</h2>
          <input type="email" name="email" placeholder="Enter Email" required class="w-100">
          <br><br>

          <input type="password" name="password" placeholder="Enter Password" required class="w-100">
          <br><br>

          <input type="submit" class="btn btn-primary btn-form" value="Login">

        </form>
      </div>

    </section>