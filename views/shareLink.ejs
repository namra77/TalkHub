<%- include('header.ejs') %>

<div class="container">
    <div>
        <img src="/<%= group.image  %>" alt="" width="200px" height="200px">

        <p><b><%= group.name %></b></p>

        <p><b>Total Members :- </b> <%= totalMembers %></p>

        <%
        if(available != 0){
            %>
            <p>Available for <b><%= available %></b> Members only.</p>
            <%
        }
        if(isOwner){
            %>
            <p>You are the admin of the group already.</p>
            <% 
        }
        else if(isJoined > 0){
            %>
            <p>You already joined this group.👍</p>
            <% 
        }
        else if(available == 0){
            %>
            <p>Group limit is already Full.👎</p>
            <% 
        }
        else {
            %>
          <button class="btn btn-primary join-now" data-id="<%= group.id %>">Join Now</button>

            <%   
        }

        %>
      
    </div>
</div>


<%- include('footer.ejs') %>