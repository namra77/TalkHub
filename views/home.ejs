<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Importing JQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- Importing Waypoints -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.js"></script>

  <!-- Importing Waypoints -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.js"></script>

  <!-- Importing Style Sheets -->
  <link rel="stylesheet" href="../css/home.css">
  <link rel="stylesheet" href="../css/header.css">
  <link rel="stylesheet" href="../css/footer1.css">
  <!-- <link rel="stylesheet" href="../css/pre-loader.css"> -->
  <!-- <link rel="stylesheet" href="../css/animation.css"> -->
  <!-- <link rel="stylesheet" href="../css/scroll.css"> -->

  <!-- Importing Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

  <!-- Importing  Sweet Alerts CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <!-- Importing  Sweet Alerts JS -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

  <!-- Importing Fancybox CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css">

  <!-- Importing Fancybox JS -->
  <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js"></script>

  <!-- Importing Animation Libraries -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

  <!-- Website title will appear in browser window -->
  <title>Talk-Hub</title>

</head>

<body>

  
  <!-- ========================================Container starts============================================== -->

  <div class="container">

    <!-- ========================================Header starts============================================== -->

    <header class="header-container">
      <div class="nav-logo-container">
        <a href="./dashboard.ejs">
          <h1 class="nav-logo">TALK HUB</h1>
        </a>
      </div>
      <nav class="nav-menu-container">
        <ul>
          <li><a href="dashboard" class="home_link">Home</a></li>
          <li><a href="about" class="about_link">About</a></li>
          <li><a href="services" class="service_link">OurServices</a></li>
          <li><a href="contact" class="contact_link">Contact Us</a></li>
        </ul>
      </nav>
      
    </header>

    <!-- ===========================================Header ends============================================= -->

    <!-- ===========================================Main starts============================================= -->

    <main>

      <!-- ========================================Section: 01 starts========================================= -->

      <section class="hero-container hero-section section-container-hero">
        <!-- No content in this section since it only displays the background image -->

      </section>

      <section class="section-container-about about-link">
        <article class="about-container">
          <article class="about-image-container">
            <div class="about-image1">
              <img src="../images/friends.jpg" alt="about-iamge1">
            </div>
            
          </article>
          <article class="about-content-container">
            <div class="about-content-title">
              <h3>Make the most out of your chats</h3>
              <h2>From Strangers to Friends</h2>
            </div>
            <div class="about-content-text">
              <p>Discover new people, make real and genuine connections, learn new languages or just have casual text or video chats. Our platform is designed to help you experience the best of online chatting</p>
            </div>
          </article>
        </article>
      </section>
      <!-- ========================================Section: 03 ends========================================= -->

      <!-- ========================================Section: 04 starts========================================= -->
       
      <section class="section-container-services services_link">
        <article class="services-container">
          <article class="service-content-container">
            <div class="service-content-title">
              <h3>Our SERVICES</h3>
              <h2>The best site to Chat with Male and Female Friends.</h2>
            </div>
            <div class="service-content-text">
              <p>Many text and video chat apps offer various features for meeting random strangers or chatting without bots, but not all of them are modern, secure and feature rich with a diverse interesting people from around the globe.</p>
            </div>
          </article>
          <article class="service-cards-container">
            <article class="service-card-container">
              <div class="service-card-details">
                <img src="../images/video.png" alt="Style Haircut">
                <h4>Video Chat</h4>
                <p>Experience authentic face to face encounters with real people from all over the world.</p>
              </div>
            </article>

            <article class="service-card-container">
              <div class="service-card-details">
                <img src="../images/typing.png" alt="Style Haircut">
                <h4>Text Chat</h4>
                <p>Not in the mood for video? No problem! You can also chat with strangers via text messages. Full of features.</p>
              </div>
            </article>

            <article class="service-card-container">
              <div class="service-card-details">
                <img src=" ./images/group.png" alt="Style Haircut">
                <h4>Dashboard</h4>
                <p>Get history of all registered users on chat.</p>
              </div>
            </article>
          </article>
        </article>
      </section>

      <section class="section-container-contact contact_link">
        <article class="contact-container">
          <article class="contact-content-container">
            <div class="contact-content-title">
              <h3>LETS CONNECTED</h3>
              <h2>Lets Connect With Us & Get In Touch With Our Professionals</h2>
            </div>
            <div class="contact-content-text">
              <p>Discover new people, make real and genuine connections, learn new languages or just have casual text or video chats. Our platform is designed to help you experience the best of online chatting.</p>
            </div>
            <address class="contact-info">
              <p>
                <span><i class="fa-solid fa-location-dot"></i></span>
                Karangploso District, Malang Regency, East Java
              </p>
              <p>
                <span><i class="fa-solid fa-envelope"></i></span>
                <a href="mailto:potongin@gmail.com">potongin@gmail.com</a>
              </p>
              <p>
                <span><i class="fa-solid fa-phone"></i></span>
                <a href="tel:+6285112345678">(+62) 851 1234 5678</a>
              </p>
            </address>
          </article>
          <article class="contact-map-container">
            <article class="map-container">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3168.8586899022065!2d-122.08424948469357!3d37.42199977982211!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x808fba2f5b4f2f1d%3A0xb3f65d45d90e7b0!2sGoogleplex!5e0!3m2!1sen!2sus!4v1614766909443!5m2!1sen!2sus"
                width="600" height="400" style="border:0;"></iframe>
            </article>
            <article class="contact-form-container">
              <form>
                <div class="form">
                  <label for="first-name">First Name</label>
                  <input type="text" name="first-name" id="first-name" placeholder="First Name">
                  <label for="last-name">Last Name</label>
                  <input type="text" name="last-name" id="last-name" placeholder="Last Name">
                </div>
                <div class="form">
                  <label for="email">Email Address</label>
                  <input type="email" name="email" id="email" placeholder="Email Address">
                  <label for="subject">Subject</label>
                  <input type="text" name="subject" id="subject" placeholder="Subject">
                </div>
                <div class="form">
                  <label for="message">Message</label>
                  <textarea name="message" id="message" cols="45" rows="5" placeholder="Your Message"></textarea>
                </div>
                <div class="submit-button">
                  <input type="submit" value="Send Message">
                </div>
              </form>
            </article>
          </article>
        </article>
      </section>

      <!-- ========================================Section: 09 ends========================================= -->

    </main>
    <!-- ========================================Main ends========================================= -->


    <!-- ========================================Footer starts========================================= -->

    <footer class="footer-container">
      <div class="footer-main">
        <div class="footer-content-container">
          <div class="footer-logo">
            <h2>TALK HUB</h2>
          </div>
          <div class="footer-text">
            <p>Experience a random chat alternative to find friends, connect with people, and chat with strangers from all over the world!.</p>
          </div>

          <form action="your-submission-url" method="POST">
            <div class="footer-input-email">
              <input type="email" name="email" id="my-email" placeholder="Email Address">
            </div>
            <div class="footer-subscribe-button">
              <input type="submit" value="Subscribe">
            </div>
          </form>

        </div>
        <div class="footer-quick-links">
          <h2>Quick Links</h2>
          <ul>
            <li>
              <span><i class="fa-solid fa-caret-right"></i></span>
              <a href="./dashboard">HomePage</a>
            </li>
            <li>
              <span><i class="fa-solid fa-caret-right"></i></span>
              <a href="./about" >About</a>
            </li>
            <li>
              <span><i class="fa-solid fa-caret-right"></i></span>
              <a href="./services" >Our Services</a>
            </li>
            <li>
              <span><i class="fa-solid fa-caret-right"></i></span>
              <a href="./contact" >Contact Us</a>
            </li>
          </ul>
        </div>
        <div class="footer-company-details">
          <h3>Our Company</h3>
          <p>Opens Everyday</p>
          <p>08:00-21:00 WB</p>
          <address class="contact-info">
            <p>
              <span><i class="fa-solid fa-location-dot"></i></span>
              Karangploso District, Malang Regency, East Java
            </p>
            <p>
              <span><i class="fa-solid fa-envelope"></i></span>
              <a href="mailto:potongin@gmail.com">talkhub@gmail.com</a>
            </p>
            <p>
              <span><i class="fa-solid fa-phone"></i></span>
              <a href="tel:+6285112345678">(+62) 851 1234 5678</a>
            </p>
          </address>
        </div>
      </div>
    </footer>

    <!-- ========================================Footer ends========================================= -->

  </div>

  <!-- ========================================Container ends========================================= -->

